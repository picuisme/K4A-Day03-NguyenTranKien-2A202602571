# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", hoặc "mock" (offline, không cần API Key)
# Đổi sang "gemini" để Chatbot Baseline, ReAct Agent VÀ Layer 2 Guardrail (guardrails.py)
# đều gọi THẬT API Gemini bằng GEMINI_API_KEY dưới đây, thay vì chạy logic mô phỏng cứng.
LLM_PROVIDER=gemini

# Google Gemini API Key — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model: gemini-3.5-flash (đã xác minh 13/09/2026 là model ID chính thức đang hoạt động
# trên Gemini API, hỗ trợ Native Function/Tool Calling — thay cho gemini-3.1-pro-preview cũ).
LLM_MODEL=gemini-3.5-flash

# ==========================================
# TIẾT KIỆM HẠN MỨC (QUOTA) — TRÁNH LỖI 429 RESOURCE_EXHAUSTED
# ==========================================
# Gói Gemini Free Tier chỉ cho phép ~5 lượt gọi/phút cho mỗi model. Mỗi câu hỏi trên Web UI
# tiêu tốn nhiều lượt: Chatbot Baseline (1) + Layer 2 Guardrail (1) + mỗi vòng lặp ReAct (1).
#
# (Tuỳ chọn) Dùng MODEL RIÊNG cho Layer 2 Guardrail. Google tính hạn mức RIÊNG theo từng model,
# nên tách Guardrail sang model khác sẽ giảm áp lực lên model chính. Để trống = dùng chung model.
# Xem danh sách model: https://ai.google.dev/gemini-api/docs/models
GUARDRAIL_MODEL=

# Nếu Google yêu cầu chờ <= số giây này, chương trình tự chờ rồi thử lại; lâu hơn thì báo người dùng.
MAX_AUTO_RETRY_WAIT_SECONDS=12

# Khi hết hạn mức API (429): tự động chuyển sang ENGINE RULE-BASED offline để demo không bị gãy,
# rồi tự quay lại dùng LLM thật khi hết thời gian chờ. Mọi câu trả lời sinh ra ở chế độ này đều
# được gắn nhãn rõ ràng trong Trace Log (rule_based_fallback=true) và trên giao diện Web.
# Đặt false nếu muốn lỗi 429 hiện thẳng ra thay vì âm thầm chạy bằng luật.
ENABLE_RULE_BASED_FALLBACK=true

# Cổng chạy Web Server cho docs/demo_ui.html (src/web_server.py).
# Mở giao diện so sánh Chatbot vs Agent tại: http://localhost:8787
WEB_UI_PORT=8787

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# Model đã nâng cấp lên gpt-5.6-sol (thay cho gpt-4o-mini cũ). Cần năng lực cao nhất: dùng "gpt-6-astra".
# LLM_MODEL=gpt-5.6-sol

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model đã nâng cấp lên claude-sonnet-5 (thay cho claude-3-5-haiku-20241022 cũ)
# LLM_MODEL=claude-sonnet-5

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
